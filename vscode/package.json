{
  "name": "blueprint-lang",
  "displayName": "Blueprint Language Support",
  "description": "Syntax highlighting, file icons, and snippets for Blueprint (.bl), Blueprint Setup (.bls), and Blueprint Modules (.blm)",
  "version": "0.1.2",
  "icon": "logo.png",
  "publisher": "LukeScarletTrial",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:blueprint",
    "onLanguage:blueprint-module"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "blueprint",
        "aliases": [
          "Blueprint",
          "blueprint"
        ],
        "extensions": [
          ".bl"
        ],
        "icon": {
          "light": "./logo.png",
          "dark": "./logo.png"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "blueprint-setup",
        "aliases": [
          "Blueprint Setup",
          "blueprint-setup"
        ],
        "extensions": [
          ".bls"
        ],
        "filenames": [
          "app.bls",
          "config.bls",
          "package.bls"
        ],
        "icon": {
          "light": "./deps_logo.png",
          "dark": "./deps_logo.png"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "blueprint-module",
        "aliases": [
          "Blueprint Module",
          "blueprint-module"
        ],
        "extensions": [
          ".blm"
        ],
        "icon": {
          "light": "./blm_logo.png",
          "dark": "./blm_logo.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blueprint",
        "scopeName": "source.blueprint",
        "path": "./blueprint.tmLanguage.json"
      },
      {
        "language": "blueprint-module",
        "scopeName": "source.blueprint",
        "path": "./blueprint.tmLanguage.json"
      },
      {
        "language": "blueprint-setup",
        "scopeName": "source.bls",
        "path": "./bls.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "blueprint",
        "path": "./snippets.json"
      }
    ]
  }
}
