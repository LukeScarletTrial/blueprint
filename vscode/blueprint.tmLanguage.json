{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Blueprint",
  "scopeName": "source.blueprint",
  "patterns": [
    {
      "name": "comment.line.double-slash.blueprint",
      "match": "//.*$"
    },
    {
      "name": "keyword.control.annotation.blueprint",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
    },
    {
      "name": "keyword.control.blueprint",
      "match": "\\b(if|else|return)\\b"
    },
    {
      "name": "keyword.declaration.blueprint",
      "match": "\\b(def|func|defstruct|import)\\b"
    },
    {
      "name": "constant.language.boolean.blueprint",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "support.type.primitive.blueprint",
      "match": "\\b(int|string|bool|void)\\b"
    },
    {
      "name": "support.function.builtin.blueprint",
      "match": "\\b(output|Setup)\\b"
    },
    {
      "name": "string.quoted.double.blueprint",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.blueprint",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.integer.blueprint",
      "match": "\\b[0-9]+\\b"
    },
    {
      "name": "entity.name.type.struct.blueprint",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    {
      "name": "variable.other.blueprint",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    },
    {
      "name": "keyword.operator.comparison.blueprint",
      "match": "==|!=|>=|<=|>|<"
    },
    {
      "name": "keyword.operator.arithmetic.blueprint",
      "match": "\\+|-|\\*|/"
    },
    {
      "name": "keyword.operator.assignment.blueprint",
      "match": "="
    },
    {
      "name": "punctuation.bracket.square.blueprint",
      "match": "\\[|\\]"
    },
    {
      "name": "punctuation.parenthesis.blueprint",
      "match": "\\(|\\)"
    },
    {
      "name": "punctuation.separator.blueprint",
      "match": "[:,.]"
    }
  ]
}
