{
  "scopeName": "source.blueprint",
  "name": "Blueprint",
  "patterns": [
    { "match": "@(blueprint)", "name": "keyword.control.blueprint" },
    { "match": "\\b(def|func|defstruct|return|if|else|true|false)\\b", "name": "keyword" },
    { "match": "\"([^\\\"]|\\.)*\"", "name": "string.quoted.double" },
    { "match": "\\b[0-9]+\\b", "name": "constant.numeric" },
    { "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b", "name": "identifier" },
    { "match": "\[|\]|\(|\)|:|,|\.|==|!=|>=|<=|>|<|=|\\+|\\-|\\*|/", "name": "punctuation" }
  ]
}
