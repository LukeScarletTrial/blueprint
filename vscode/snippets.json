{
  "Function Declaration": {
    "prefix": "func",
    "body": [
      "func ${1:FunctionName}(${2:params}): [",
      "\t${0}",
      "]"
    ],
    "description": "Blueprint function definition"
  },
  "Struct Definition": {
    "prefix": "defstruct",
    "body": [
      "defstruct ${1:StructName} [",
      "\t${2:field}: ${3:type}",
      "]"
    ],
    "description": "Blueprint structure definition"
  },
  "Variable Declaration": {
    "prefix": "def",
    "body": [
      "def ${1:varName} = ${2:value}"
    ],
    "description": "Blueprint variable declaration"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} [",
      "\t${2}",
      "] else [",
      "\t${3}",
      "]"
    ],
    "description": "Blueprint if-else block"
  },
  "Setup Statement": {
    "prefix": "setup",
    "body": [
      "Blueprint.Setup(\"${1:App Name}\", ${2:true})"
    ],
    "description": "Blueprint.Setup initialization"
  }
}
